# =============================================================================
# ENMProperty Backend - contoh konfigurasi environment
# Salin berkas ini menjadi .env lalu sesuaikan nilainya:
#     Copy-Item .env.example .env
# Jangan pernah menuliskan kredensial asli ke berkas ini.
# Semua nilai di bawah dibaca oleh internal/config.
# =============================================================================

# --- Aplikasi (BE-01) ---------------------------------------------------------
APP_NAME=enmproperty-api
# development | staging | production
APP_ENV=development
# Zona waktu untuk format tanggal laporan (WIB)
APP_TIMEZONE=Asia/Jakarta
APP_FRONTEND_URL=http://localhost:3000
# Landing page WordPress, ikut diizinkan pada CORS
APP_WORDPRESS_URL=
# Nomor WhatsApp admin cadangan, dipakai bila mitra paket Free belum mengisi nomor
APP_WHATSAPP_ADMIN=
# Jumlah hari sebelum masa aktif paket berakhir untuk memunculkan banner alert (BE-07)
APP_SUBSCRIPTION_REMINDER_DAYS=7
# Shared secret revalidasi ISR landing page (tombol "Publish Perubahan Landing Page"
# memanggil GET /api/revalidate di frontend). String acak panjang.
# Harus sama persis dengan REVALIDATION_TOKEN pada frontend.
APP_REVALIDATION_TOKEN=

# --- HTTP Server (BE-01) ------------------------------------------------------
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=60s
# Batas waktu satu request (middleware Timeout)
HTTP_REQUEST_TIMEOUT=30s
# Batas ukuran body request (middleware BodyLimit), 10 MB
HTTP_MAX_BODY_BYTES=10485760
HTTP_SHUTDOWN_TIMEOUT=15s

# --- PostgreSQL (pgxpool) -----------------------------------------------------
# Driver penyimpanan: memory (data contoh, tanpa PostgreSQL) atau postgres
DB_DRIVER=memory
DB_URL=postgres://postgres:postgres@localhost:5432/enmproperty?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
# Berkas migrasi SQL di-embed ke dalam biner (backend/migrations); DB_MIGRATIONS_PATH
# tidak lagi dipakai dan hanya dipertahankan untuk kompatibilitas.
DB_MIGRATIONS_PATH=./migrations
# Terapkan migrasi otomatis saat aplikasi start. Disarankan hanya untuk
# pengembangan; pada produksi jalankan migrasi secara terkendali.
DB_AUTO_MIGRATE=false

# --- Firebase Admin SDK (BE-02, BE-03, middleware FirebaseAuth) ---------------
FIREBASE_PROJECT_ID=
# Path ke service account JSON; biarkan kosong bila memakai mode dev atau
# GOOGLE_APPLICATION_CREDENTIALS.
FIREBASE_CREDENTIALS_FILE=
# Bucket Firebase Storage, juga dipakai bila STORAGE_DRIVER=gcs
FIREBASE_STORAGE_BUCKET=
FIREBASE_DATABASE_URL=

# --- Autentikasi (token uji pengembangan) -------------------------------------
# Izinkan token uji AUTH_DEV_TOKEN agar backend dapat dites tanpa Firebase.
# Wajib false bila APP_ENV=production.
AUTH_DEV_MODE=false
AUTH_DEV_TOKEN=dev-token

# --- Midtrans (BE-08) ---------------------------------------------------------
# Default false: checkout Midtrans nonaktif, paket Free tetap berjalan.
# Wajib true dan kunci wajib terisi agar checkout paket berbayar berfungsi.
MIDTRANS_ENABLED=false
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
# false = sandbox, true = produksi
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_SNAP_BASE_URL=https://app.sandbox.midtrans.com
# Menit sebelum order yang belum dibayar dianggap kedaluwarsa
MIDTRANS_ORDER_EXPIRY_MINUTES=60

# --- Penyimpanan foto properti (BE-10) ----------------------------------------
# local = disk lokal, gcs = Firebase Storage / Google Cloud Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_PUBLIC_BASE_URL=http://localhost:8080/uploads
STORAGE_MAX_UPLOAD_BYTES=5242880
STORAGE_MAX_PHOTOS_PER_PROPERTY=10
STORAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp

# --- CORS (hanya origin Next.js dan WordPress) --------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Request-Id
CORS_ALLOW_CREDENTIALS=true
CORS_MAX_AGE=12h

# --- Rate limit (middleware RateLimit) ----------------------------------------
RATE_LIMIT_ENABLED=true
# memory | redis
RATE_LIMIT_STORE=memory
RATE_LIMIT_REDIS_URL=
# Batas umum per IP
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=1m
# Batas khusus per route
RATE_LIMIT_AUTH_REQUESTS=20
RATE_LIMIT_CHECKOUT_REQUESTS=10
RATE_LIMIT_WEBHOOK_REQUESTS=120

# --- Scheduler (BE-16) --------------------------------------------------------
SCHEDULER_ENABLED=true
# ExpireSubscriptions: harian dini hari
SCHEDULER_EXPIRE_SUBSCRIPTIONS_CRON=0 1 * * *
# ExpireStaleOrders: tiap 15 menit
SCHEDULER_EXPIRE_ORDERS_CRON=*/15 * * * *

# --- Logging (zerolog) --------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json | console
LOG_FORMAT=json
